{{- /* Default packages */ -}}
{{- $packages := list "base-devel" "curl" "git" "gnupg" "unzip" "wget" "1password-cli" -}}
{{- if .system.laptop -}} {{- $packages := concat $packages ( list "kanata" ) | sortAlpha  -}} {{- end -}}


#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Initial machine setup
# ---------------------------------------------------------------------------

{{/* Include external functions */}}
{{ template "install-mise.tmpl" . }}
{{ template "install-opencode.tmpl" . }}
{{ template "install-rust.tmpl" . }}
{{ template "setup-1password.tmpl" . }}
{{ template "setup-kanata.tmpl" . }}

#######################################
# Install Git Credential Manager
# https://github.com/git-ecosystem/git-credential-manager
# Globals:
#   None
# Arguments:
#   None
#######################################
function install_gcm() {
    arch="linux_amd64"
    version="2.6.0"
    zip_file="gcm-$arch.$version.tar.gz"

    echo "Installing Git Credential Manager..."
    curl -L -O "https://github.com/git-ecosystem/git-credential-manager/releases/download/v$version/$zip_file"
    sudo tar -xvf "$zip_file" -C /usr/local/bin
    rm "$zip_file"

}


#######################################
# Install yay package manager
# https://github.com/jguer/yay
# Globals:
#   None
# Arguments:
#   None
#######################################
function install_yay() {
    if command -v yay >/dev/null 2>&1; then
        return
    fi

    sudo pacman -S --needed --noconfirm base-devel git
    git clone https://aur.archlinux.org/yay.git
    makepkg -D yay -si --noconfirm
    rm -rf yay
}


#################### Main Program ####################

# Stop script on error
set -euo pipefail

# Install package manager
install_yay

# Install packages
yay -Syu --noconfirm
yay -S --needed --noconfirm {{ $packages | join " " }}

{{ if not .env.ephemeral -}}

# Install Git Credential Manager
install_gcm

# Install mise-en-place
install_mise

# Install opencode
install_opencode

# Install Rust
install_rust

# Install 1Password CLI
setup_1password

{{ end }}

{{ if .system.laptop }}

# Setup kanata
setup_kanata

{{ end }}
