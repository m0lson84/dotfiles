{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "agents": {
    "plan": { "model": "github-copilot/gpt-5.6-sol" },
    "build": { "model": "github-copilot/gpt-5.6-terra" },
    "general": { "model": "github-copilot/gpt-5.6-terra" },
    "explore": { "model": "github-copilot/claude-haiku-4.5" },
    "title": { "model": "github-copilot/gpt-5.6-luna" }
  },
  "providers": {
    "amazon-bedrock": {
      "settings": {
        "profile": "bedrock",
        "region": "us-east-1"
      }
    }
  },
  "mcp": {
    "servers": {
      "aws-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-proxy-for-aws@latest",
          "https://aws-mcp.us-east-1.api.aws/mcp",
          "--metadata",
          "INSTALL_SOURCE=aws-cli"
        ],
        "environment": {
          "AWS_PROFILE": "{env:AWS_PROFILE}"
        }
      }
    }
  },
  "formatter": true,
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" }
  ],
  "tool_output": {
    "max_lines": 600,
    "max_bytes": 24000
  },
  "compaction": {
    "auto": true,
    "buffer": 12000
  }
}
