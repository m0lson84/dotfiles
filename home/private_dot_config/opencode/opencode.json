{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@upstash/context7-opencode"],
  "enabled_providers": ["amazon-bedrock", "github-copilot", "opencode"],
  "model": "github-copilot/claude-sonnet-5",
  "small_model": "github-copilot/gpt-5.6-luna",
  "agent": {
    "plan": { "model": "github-copilot/gpt-5.6-sol" },
    "build": { "model": "github-copilot/gpt-5.6-terra" },
    "general": { "model": "github-copilot/gpt-5.6-terra" },
    "explore": { "model": "github-copilot/claude-haiku-4.5" }
  },
  "provider": {
    "amazon-bedrock": {
      "options": {
        "profile": "bedrock",
        "region": "us-east-1"
      }
    }
  },
  "formatter": true,
  "lsp": true,
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git *": "ask"
    }
  },
  "tool_output": {
    "max_lines": 600,
    "max_bytes": 24000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  }
}
